<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.collections.FXCollections?>

<?import javafx.geometry.Insets?>
<BorderPane prefWidth="820" prefHeight="520"
            stylesheets="@../../css/darktheme.css"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="fyzzbox.physicsapp.controller.SettingsWindowController">

    <!-- ===== LEFT SIDEBAR ===== -->
    <left>
        <VBox spacing="10" styleClass="settings-sidebar" prefWidth="180">
            <Label text="Settings" styleClass="heading-2"/>

            <Button onAction="#onGeneralTabClicked" text="General" styleClass="settings-tab"/>
            <Button onAction="#onDisplayTabClicked" text="Display" styleClass="settings-tab"/>
            <Button onAction="#onSimulationTabClicked" text="Simulation" styleClass="settings-tab"/>
            <Button onAction="#onControlsTabClicked" text="Controls" styleClass="settings-tab"/>
        </VBox>
    </left>

    <!-- ===== MAIN CONTENT (General tab selected) ===== -->
    <center>
        <VBox spacing="16" styleClass="settings-content">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>
            <Label fx:id="sectionTitle" text="General Settings" styleClass="heading-2"/>

            <HBox spacing="10">
                <Label text="Theme:"/>
                <ComboBox fx:id="themeSelector" prefWidth="140">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="Dark"/>
                            <String fx:value="Light"/>
                        </FXCollections>
                    </items>
                </ComboBox>
            </HBox>

            <HBox spacing="10">
                <Label text="Autosave Interval:"/>
                <TextField fx:id="autosaveField" prefWidth="60" text="10"/>
            </HBox>

            <HBox spacing="10">
                <Label text="Show Tooltips:"/>
                <CheckBox fx:id="showTooltips" selected="true"/>
            </HBox>
        </VBox>
    </center>

    <!-- ===== BOTTOM BUTTON BAR ===== -->
    <bottom>
        <HBox spacing="10" alignment="CENTER_RIGHT" styleClass="settings-bottom-bar">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <Button onAction="#onCancelClicked" text="Cancel" styleClass="menu-button"/>
            <Button onAction="#onApplyClicked" text="Apply" styleClass="menu-button"/>
            <Button onAction="#onSaveClicked" text="Save" styleClass="menu-button"/>
        </HBox>
    </bottom>

</BorderPane>


